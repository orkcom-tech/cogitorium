      "body": "\u003ca class=\"action{{if .Danger}} is-danger{{end}}\" href=\"{{.Href}}\"\n  data-method=\"{{.Method}}\"{{if .Confirm}} data-confirm=\"{{.Confirm}}\"{{end}}{{if .Target}} data-target=\"{{.Target}}\"{{end}}\u003e{{.Label}}\u003c/a\u003e",
