      ],
      "body": "\u003carticle class=\"card instruction{{if .Open}} is-open{{end}}\"\u003e\n  \u003cheader class=\"instruction-head\"\u003e\n    \u003ch3\u003e{{.Name}}\u003c/h3\u003e\n    {{range .Tags}}\u003cspan class=\"badge\"\u003e{{.}}\u003c/span\u003e{{end}}\n  \u003c/header\u003e\n  {{if .Description}}\u003cp class=\"hint\"\u003e{{.Description}}\u003c/p\u003e{{end}}\n  {{if .Open}}\u003cpre class=\"instruction-text\"\u003e{{.Text}}\u003c/pre\u003e{{end}}\n  \u003cdiv class=\"instruction-actions\"\u003e\n    \u003ca href=\"/instructions?open={{.ID}}\"\u003e{{if .Open}}Hide{{else}}Read{{end}}\u003c/a\u003e\n    \u003cform method=\"post\" action=\"/instructions/{{.ID}}/delete\"\n          hx-post=\"/instructions/{{.ID}}/delete\" hx-target=\"#library-list\" hx-swap=\"outerHTML\"\n          hx-confirm=\"Delete {{.Name}}? Its text stays in Contextverse; the entry goes.\"\u003e\n      \u003cbutton type=\"submit\" class=\"danger\"\u003eDelete\u003c/button\u003e\n    \u003c/form\u003e\n    {{if .UpdatedAt}}\u003cspan class=\"hint\"\u003e{{.UpdatedAt}}\u003c/span\u003e{{end}}\n  \u003c/div\u003e\n\u003c/article\u003e",
