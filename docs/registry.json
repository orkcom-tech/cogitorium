        },
        {
          "path": "Ctx.T.Navigation",
          "type": "string"
        },
        {
          "path": "Ctx.T.Instructions",
          "type": "string"
        },
        {
          "path": "Items",
          "type": "[]Instruction"
        },
        {
          "path": "Query",
          "type": "string"
        },
        {
          "path": "Tag",
          "type": "string"
        },
        {
          "path": "Tags",
          "type": "[]Tag"
        },
        {
          "path": "Narrowed",
          "type": "bool"
        },
        {
          "path": "Error",
          "type": "string"
        }
      ],
      "body": "\u003cmain class=\"page library\"\u003e\n  \u003ch2\u003e{{.Ctx.T.Instructions}}\u003c/h2\u003e\n\n  {{if .Error}}\u003cp class=\"error\"\u003e{{.Error}}\u003c/p\u003e{{end}}\n\n  \u003cform class=\"library-filters\" method=\"get\" action=\"/instructions\"\n        hx-get=\"/instructions\" hx-target=\"#library-list\" hx-swap=\"outerHTML\"\n        hx-trigger=\"submit, input from:input[name='q'] delay:250ms, change from:select\"\u003e\n    \u003cinput type=\"search\" name=\"q\" value=\"{{.Query}}\" placeholder=\"Search names, descriptions and text\"\n           aria-label=\"Search the library\"\u003e\n    \u003cselect name=\"tag\" aria-label=\"Filter by tag\"\u003e\n      \u003coption value=\"\"\u003eevery tag\u003c/option\u003e\n      {{range .Tags}}\u003coption value=\"{{.Name}}\"{{if .Selected}} selected{{end}}\u003e{{.Name}}\u003c/option\u003e{{end}}\n    \u003c/select\u003e\n    \u003cnoscript\u003e\u003cbutton type=\"submit\"\u003eSearch\u003c/button\u003e\u003c/noscript\u003e\n  \u003c/form\u003e\n\n  \u003cdetails class=\"library-write\"\u003e\n    \u003csummary\u003eWrite one\u003c/summary\u003e\n    {{/* A plain POST to this page. The answer is the page again, which is what\n         makes it work with nothing loaded. */}}\n    \u003cform method=\"post\" action=\"/instructions\"\u003e\n      \u003clabel\u003eName \u003cinput name=\"name\" required pattern=\"[a-z][a-z0-9-]*\"\n                         placeholder=\"lowercase-with-dashes\"\u003e\u003c/label\u003e\n      \u003clabel\u003eDescription \u003cinput name=\"description\" placeholder=\"What it is for, in one line\"\u003e\u003c/label\u003e\n      \u003clabel\u003eTags \u003cinput name=\"tags\" placeholder=\"comma, separated\"\u003e\u003c/label\u003e\n      \u003clabel\u003eText \u003ctextarea name=\"text\" rows=\"8\" required\n                            placeholder=\"The instruction itself. It is versioned in Contextverse.\"\u003e\u003c/textarea\u003e\u003c/label\u003e\n      \u003cbutton type=\"submit\"\u003eSave it\u003c/button\u003e\n    \u003c/form\u003e\n  \u003c/details\u003e\n\n  {{template \"cog.list.instructions\" .}}\n\u003c/main\u003e",
      "appends": false
    },
