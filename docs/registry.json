      "body": "\u003cdiv id=\"library-list\" class=\"library-list\"\u003e\n{{if .Items}}{{range .Items}}{{template \"cog.row.instruction\" .}}{{end}}{{else}}{{template \"cog.empty.instructions\" .}}{{end}}\n\u003c/div\u003e",
