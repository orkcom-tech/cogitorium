[Unit]
Description=Cogitorium — a modular workbench for deterministic workflows built on models
Documentation=https://orkcom-tech.github.io/cogitorium/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cogitorium
Group=cogitorium
# The contextd this package carries. It lives under /usr/libexec rather than on
# PATH so it cannot collide with a contextd somebody installs properly — dpkg
# refuses to unpack a package over another package's file, and two packages
# both owning /usr/bin/contextd would be mutually uninstallable.
#
# Named here rather than found: the service runs as its own user with a
# restricted environment, so "whatever is on PATH" is not a thing this unit
# should be relying on either way.
Environment=COGITORIUM_CONTEXTD=/usr/libexec/cogitorium/contextd
# HOME is where contextd keeps its space, and a system user has none unless it
# is given one. Without this the space would land somewhere the unit cannot
# write and context would report unavailable on a machine that has everything
# it needs.
Environment=HOME=/var/lib/cogitorium
# Loopback by default. This server holds provider API keys, and on any other
# address it requires a token — that is the same binary behaving differently,
# not a second mode, so widening the bind is a deliberate edit here.
ExecStart=/usr/bin/cogitorium serve --listen 127.0.0.1:8688 --data /var/lib/cogitorium
Restart=always
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM
KillMode=mixed
LimitNOFILE=65536

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/cogitorium

# Contextverse: context storage is delegated to contextd, which is a separate
# program. The server starts without it and says so at /api/v1/context/status
# rather than failing — but memory and bound documents do not work until it is
# installed. The package recommends it; see packaging/README.md.

# Readiness: GET /health → 200 {"status":"ok","version":"…"}

[Install]
WantedBy=multi-user.target
