{
  "version": "__VERSION__",
  "description": "A modular workbench for building deterministic, repeatable workflows that have models in them — agents, wiring, context, gears and pipelines, set by hand or by the orchestrator. Local-first, no telemetry.",
  "homepage": "https://orkcom-tech.github.io/cogitorium/",
  "license": "BUSL-1.1",
  "_comment": "Canonical manifest lives in https://github.com/orkcom-tech/scoop-bucket — this copy is the template scripts/ci/publish-packages.sh fills. `depends` is Contextverse: context and memory are stored by contextd, and Scoop can express that, so it does.",
  "depends": "contextverse/contextd",
  "architecture": {
    "64bit": {
      "url": "https://github.com/orkcom-tech/cogitorium/releases/download/v__VERSION__/cogitorium___VERSION___windows_amd64.zip",
      "hash": "__WIN_AMD64__",
      "bin": "cogitorium.exe"
    },
    "arm64": {
      "url": "https://github.com/orkcom-tech/cogitorium/releases/download/v__VERSION__/cogitorium___VERSION___windows_arm64.zip",
      "hash": "__WIN_ARM64__",
      "bin": "cogitorium.exe"
    }
  },
  "checkver": {
    "github": "https://github.com/orkcom-tech/cogitorium"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/orkcom-tech/cogitorium/releases/download/v$version/cogitorium_$version_windows_amd64.zip"
      },
      "arm64": {
        "url": "https://github.com/orkcom-tech/cogitorium/releases/download/v$version/cogitorium_$version_windows_arm64.zip"
      }
    },
    "hash": {
      "url": "$baseurl/checksums.txt"
    }
  },
  "notes": [
    "Start it with:  cogitorium serve",
    "Then open http://127.0.0.1:8688",
    "Gears and the terminal need Docker Desktop to be isolated. Without it, gears run with this server's own file access and the terminal refuses to open."
  ]
}
