bin/
web/node_modules/
web/dist/*
!web/dist/.gitkeep
web/tsconfig.tsbuildinfo

# This repository lives inside a synced Documents folder, and the file
# provider resolves conflicts by leaving a copy beside the original: "App
# 2.tsx", "@types/estree 5". One of those duplicates broke a TypeScript build
# because it sat inside tsconfig's include. They are never ours.
* 2.*
* 3.*
* 4.*
* 5.*

# macOS writes these into every folder it has been looked at in.
.DS_Store

# A stray build output: `go build ./cmd/cogitorium` with no -o drops the
# binary here, and an 18MB blob in a commit is noticed a release too late.
/cogitorium
/cogitorium-desktop

# Agent worktrees and session scratch. These are checkouts of THIS repository,
# so committing them records gitlinks nobody can resolve.
.claude/

# Where scripts/ci/fetch-contextd.sh stages the Contextverse binaries the
# release artifacts carry. Not dist/, because goreleaser refuses to run with
# anything in dist before it builds.
/build/
internal/wasmrt/testdata/guest.wasm

# Built plugin artifacts. The source is in the sample; the module is whatever
# your toolchain produced from it, and a 1 MB blob per commit is not a diff
# anybody reads.
examples/plugins/*/plugin.wasm
examples/plugins/*/target/
/*.zip
